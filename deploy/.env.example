# Settings for deploy/compose.yaml. Copy to .env in this directory and fill in.

# REQUIRED. The database password, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# REQUIRED. The public URL users reach the app at. The server's CSRF check compares each
# state-changing request's Origin header against it; behind a TLS-terminating proxy the app would
# otherwise see an internal Host that never matches. Comma-separated for an instance reachable at
# more than one address.
# ORIGIN="https://deckshare.example"
ORIGIN=

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For header the server may trust. Set it
# to the proxy's address range, or every request looks like it came from the proxy and the per-IP
# login/signup limiters collapse into one instance-wide bucket. Only ever ranges you control.
# TRUSTED_PROXY="172.16.0.0/12"

# Gates new-account creation: "open" (default) lets anyone register; "closed" 404s GET /signup and
# 403s POST /signup.
# SIGNUP_MODE=closed

# "json" (the default here) for a log collector; "text" is friendlier to read by hand.
# LOG_FORMAT=json

# The image tag to run. Pin a release (e.g. 0.3.19) rather than following latest.
# DECKSHARE_VERSION=latest

# Where the app port is published on the host. The default keeps it loopback-only, for a reverse
# proxy on the same host; set 0.0.0.0 only if nothing in front of it terminates TLS.
# BIND_ADDR=127.0.0.1
# APP_PORT=3000
