# Drizzle
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# SvelteKit's CSRF protection (src/hooks.server.ts) compares each request's Origin header
# against the server's own origin. Behind a reverse proxy that terminates TLS, the app may
# otherwise see an internal Host (e.g. localhost:3000) that never matches the browser's real
# Origin, causing every state-changing request to 403. Set this to the public URL so the
# comparison uses the right origin instead of being weakened to fix the symptom.
# ORIGIN="https://your-domain.example"
