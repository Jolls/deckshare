# Local scratch — also where a real (copyrighted, non-redistributable) .apkg fixture lives
# during manual inspection; see docs/apkg-format.md. Must never be committed.
.local/

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json
.claude/memory/*

# Go build output
/bin/
/deckshare
/deckshare.exe
*.test
coverage.out
/media

# run-app skill's media directory, bind-mounted into the app container
.claude/skills/run-app/.media/
# Legacy: the host binary, pid and log run-app wrote before the app moved into compose (#274).
# Kept so copies left in existing checkouts stay out of `git add -A`.
.claude/skills/run-app/.server.pid
.claude/skills/run-app/.server.log
.claude/skills/run-app/.deckshare-server.exe
.claude/skills/run-app/.deckshare-server.exe~

# Playwright / Node (tests/e2e)
node_modules/
/test-results/
/playwright-report/
/playwright/.cache/
